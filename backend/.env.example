# Configurar no projeto backend da Vercel, nunca em VITE_*.
FIREBASE_PROJECT_ID=intelectusai
# JSON completo da conta de serviço, em uma linha.
FIREBASE_SERVICE_ACCOUNT=
# Chave exclusiva de pelo menos 32 bytes; necessária para login interno.
JWT_SECRET=
# Opcionais: sem Gemini, a trilha usa o fallback local de conteúdo.
GEMINI_API_KEY=
YOUTUBE_API_KEY=
