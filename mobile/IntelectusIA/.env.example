# Use the public Firebase API key from the same project as the website.
EXPO_PUBLIC_FIREBASE_API_KEY=
# Optional: backend URL reachable from the phone, e.g. http://192.168.1.10:3000.
# Without this, development derives the computer address from the Expo server.
# Release builds use the deployed API when this value is absent.
EXPO_PUBLIC_API_URL=
